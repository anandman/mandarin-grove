{
  "name": "mandarin-grove-mobile",
  "version": "1.0.101",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:bridge": "esbuild src/bridge.ts --bundle --platform=browser --format=iife --define:__GROVE_INTERNAL_TESTS__=false --minify-syntax --outfile=dist/bridge.js",
    "build": "npm run build:bridge && node ../scripts/export-mobile.cjs",
    "sync": "cap sync",
    "typecheck": "tsc --noEmit",
    "build:testing": "esbuild src/bridge.ts --bundle --platform=browser --format=iife --define:__GROVE_INTERNAL_TESTS__=true --minify-syntax --outfile=dist/bridge-testing.js && node ../scripts/export-mobile.cjs --internal-tests"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
