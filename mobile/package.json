{
  "name": "mandarin-grove-mobile",
  "version": "0.1.0",
  "private": true,
  "engines": {"node": ">=22"},
  "scripts": {
    "build:bridge": "esbuild src/bridge.ts --bundle --platform=browser --format=iife --outfile=dist/bridge.js",
    "build": "npm run build:bridge && node ../scripts/export-mobile.cjs",
    "sync": "cap sync",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/android": "8.6.0",
    "@capacitor-community/sqlite": "8.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
